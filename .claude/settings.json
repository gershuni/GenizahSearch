{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format --check:*)",
      "Bash(python scripts/check_docs.py:*)",
      "Bash(python scripts/check_atlas_masking.py:*)",
      "Bash(python scripts/bump_version.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git check-ignore:*)",
      "Bash(git branch:*)",
      "Bash(git blame:*)",
      "Bash(git stash list:*)",
      "Bash(git worktree list:*)",

      "PowerShell(pytest:*)",
      "PowerShell(python -m pytest:*)",
      "PowerShell(ruff check:*)",
      "PowerShell(ruff format --check:*)",
      "PowerShell(python scripts/check_docs.py:*)",
      "PowerShell(python scripts\\check_docs.py:*)",
      "PowerShell(python scripts/check_atlas_masking.py:*)",
      "PowerShell(python scripts\\check_atlas_masking.py:*)",
      "PowerShell(python scripts/bump_version.py:*)",
      "PowerShell(python scripts\\bump_version.py:*)",
      "PowerShell(powershell -File scripts/init.ps1:*)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/init.ps1:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git show:*)",
      "PowerShell(git rev-parse:*)",
      "PowerShell(git check-ignore:*)",
      "PowerShell(git branch:*)",
      "PowerShell(git blame:*)",
      "PowerShell(git stash list:*)",
      "PowerShell(git worktree list:*)",
      "PowerShell(Get-ChildItem:*)",
      "PowerShell(Get-Item:*)",
      "PowerShell(Test-Path:*)",
      "PowerShell(Measure-Object:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(.masking_patterns)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/*)",
      "Read(**/*credential*)",
      "Read(.claude/settings.local.json)",
      "Read(.claude/settings.local.json.*)"
    ]
  }
}
