fist_data/*
# Phase 85 SYNTH-02: synthetic_manifest.json is AUTHORITATIVE for Plan 03 —
# must be tracked so the FJMS sidecar exporter (Plan 03) can read the
# committed qualifying-set as its only InventoryId source. Pattern uses
# `fist_data/*` (not `fist_data/`) so the !-exception works correctly:
# git cannot re-include files inside an excluded *directory*, but can
# re-include files inside an excluded *glob* pattern.
!fist_data/synthetic_manifest.json
nli_data/
# PGP sidecar DB + its backup siblings. Was the single literal `pgp_data/pgp.db`,
# which left copies like `pgp_data/pgp_backup_<date>.db` untracked-but-NOT-ignored
# — so a repo-wide content scan enumerated them and failed closed
# on strings that the live pgp.db carries too and that this line already excludes
# by design (PGP scholarly metadata legitimately cites source corpora).
# Glob-scoped to *.db only: pgp_data/full_import_report.txt and
# pgp_data/import_report.csv REMAIN TRACKED.
pgp_data/*.db
FIST_DB_BACKUP/
# FGP transcription archive (local sidecar).
# Large (~1.5 GB, 48K files); never committed. Manifest lives inside.
fgp_data/

