# =============================================================================
# SYSTEMD SERVICE EXAMPLE
# =============================================================================
#
# /etc/systemd/system/genizah-backend.service:
# [Unit]
# Description=Genizah Backend API
# After=network.target postgresql.service
#
# [Service]
# User=genizah
# WorkingDirectory=/opt/genizah
# EnvironmentFile=/opt/genizah/.env
# ExecStart=/opt/genizah/venv/bin/python -m backend.main
# Restart=always
#
# [Install]
# WantedBy=multi-user.target
#
# /etc/systemd/system/genizah-web.service:
