# Description=Genizah Web Interface
# After=network.target genizah-backend.service
#
# [Service]
# User=genizah
# WorkingDirectory=/opt/genizah
# EnvironmentFile=/opt/genizah/.env
# ExecStart=/opt/genizah/venv/bin/python -m web.main
# Restart=always
