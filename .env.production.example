# Production Environment Configuration for AWS Deployment
# Copy this file to .env and update the values

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Full URL to your backend API (used by web frontend)
# If using nginx reverse proxy on same domain: https://your-domain.com/api/v1
# If API on separate subdomain: https://api.your-domain.com/api/v1
CORRECTIONS_API_URL=https://genizah.dicta.org.il/api/v1

# CORS origins - comma-separated list of allowed origins
# Include your domain and any subdomains
CORS_ORIGINS=https://genizah.dicta.org.il,https://www.genizah.dicta.org.il

# Database connection (PostgreSQL recommended for production)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://genizah_user:your_secure_password@localhost:5432/genizah_db

# Secret key for JWT tokens (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
# IMPORTANT: Keep this secret and consistent across deployments
SECRET_KEY=your-secure-random-secret-key-here

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# Environment mode
ENVIRONMENT=production
DEBUG=false

# Backend API port (default: 8000) - used internally, nginx proxies to this
GENIZAH_BACKEND_PORT=8000

# Web interface port (default: 8081) - used internally, nginx proxies to this
GENIZAH_PORT=8081

# Alternative: Build API URL from parts instead of CORRECTIONS_API_URL
# API_HOST=genizah.dicta.org.il
# API_SCHEME=https

