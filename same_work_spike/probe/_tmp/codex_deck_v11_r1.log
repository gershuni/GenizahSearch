  223: def genre_conflict(titles, claim_tokens):
  224:     """True when every generic title has genre classes and NONE accepts the
  225:     claim's genre. Unknown genres on either side -> no conflict (fail open)."""
  226:     claim_g = {CLAIM_GENRE_OF[t] for t in claim_tokens if t in CLAIM_GENRE_OF}
  227:     if not claim_g:
  228:         return False
  229:     t_classes = set()
  230:     for t in titles:
  231:         for tk in tokens(t):
  232:             if tk in GENRE_OF:
  233:                 t_classes.add(GENRE_OF[tk])
  234:     if not t_classes:
  235:         return False
  236:     return not any(claim_g & GENRE_OK.get(g, {g}) for g in t_classes)
