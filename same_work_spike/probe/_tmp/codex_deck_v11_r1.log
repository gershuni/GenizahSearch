  263: def _expand_variants(tks):
  264:     out = set(tks)
  265:     for a, b in VARIANT_TABLE:
  266:         if out & a:
  267:             out |= b
  268:         if out & b:
  269:             out |= a
  270:     return out
  271: 
  272: 
  273: def _sig(tks):
  274:     return {t for t in tks if t not in WEAK_TOKENS and len(t) >= 3}
