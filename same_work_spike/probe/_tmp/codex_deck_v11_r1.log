  819:     def reversed_citation(row):
  820:         """Work-side citation formula at the aligned span head while the
  821:         page side is clean -> the EDITION quotes the source the page
  822:         carries directly (blind card #23): a potential find, not a leak."""
  823:         if (row[1], row[3]) in exempt_cite:
