  830:             return False
  831:         res = partial_ratio_alignment(sl, ws, score_cutoff=45)
  832:         if res is None:
  833:             return False
  834:         wwin = ws[max(0, res.dest_start - 45):res.dest_start + 12]
  835:         return any(nm in wwin for nm in norm_markers)
