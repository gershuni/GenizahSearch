  239: def _is_generic_token(t):
  240:     """Generic test with Hebrew prefix particles stripped (׳‘׳“׳§׳“׳•׳§ -> ׳“׳§׳“׳•׳§,
  241:     ׳•׳₪׳¨׳©׳ ׳•׳× -> ׳₪׳¨׳©׳ ׳•׳×). Up to two leading particles."""
  242:     if t in GENERIC_TOKENS or len(t) <= 2 or t.isdigit():
  243:         return True
  244:     cur = t
  245:     for _ in range(2):
  246:         if cur[:1] in _PREFIXES and len(cur) > 3:
  247:             cur = cur[1:]
  248:             if cur in GENERIC_TOKENS:
  249:                 return True
  250:         else:
  251:             break
  252:     return False
