  277: def match_same(claim_tokens, title_tokens):
  278:     """(matched, via_variant). Requires >=2 significant shared tokens, or
  279:     one highly distinctive (len>=5) shared token."""
  280:     a = _sig(claim_tokens)
  281:     b = _sig(title_tokens)
  282:     inter = a & b
  283:     direct = len(inter) >= 2 or any(len(t) >= 5 for t in inter)
  284:     if direct:
  285:         return True, False
  286:     a2 = _expand_variants(claim_tokens)
  287:     b2 = _expand_variants(title_tokens)
  288:     inter2 = _sig(a2) & _sig(b2)
  289:     if len(inter2) >= 2 or any(len(t) >= 5 for t in inter2):
  290:         return True, True
  291:     return False, False
