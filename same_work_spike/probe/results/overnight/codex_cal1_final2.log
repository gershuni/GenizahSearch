+    hw = work_weights(hold, by_alen)
+    rel = defaultdict(lambda: [0.0, 0.0, 0])
+    for r in hold:
+        p = p_deploy(r, model, margin_model, singleton_null)
+        b = min(9, int(p * 10))
+        Lr = nearest_bin(r.get('alen') or r['len']) if by_alen else r['len']
+        w = hw[(Lr, r['true_work'])]
+        rel[b][0] += r['correct'] * w
+        rel[b][1] += w
+        rel[b][2] += 1
