  939:             A(f"| {e['set']} | {e['len']} | {e['dens']:.3f} | {e['pred']:.3f} "
  940:               f"| {e['grade']} | {'ג“' if e['human_correct'] else 'ג—'} |")
  941:         n_ok = sum(e['human_correct'] for e in external)
  942:         mean_p = sum(e['pred'] for e in external) / len(external)
