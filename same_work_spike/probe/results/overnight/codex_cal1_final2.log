  530:     chance would NOT produce a candidate this good. High-density singletons
  531:     (d > ~0.45) get low P automatically ג€” chance singletons are common
  532:     there (pilot n20 decoy_accept ~0.40 at len150/d0.50)."""
  533:     null = {}
  534:     for L, n_total in n_decoy_by_len.items():
  535:         ds = sorted(decoy_best.get(L, []))
  536:         if not n_total:
  537:             continue
  538:         knots = []
  539:         for i, d in enumerate(ds):
  540:             knots.append([round(d, 4), round((i + 1) / n_total, 5)])
  541:         if len(knots) > max_knots:
  542:             step = len(knots) / max_knots
  543:             knots = [knots[int(i * step)] for i in range(max_knots - 1)]
  544:             knots.append([round(ds[-1], 4), round(len(ds) / n_total, 5)])
  545:         null[L] = knots
  546:     return null
  547: 
  548: 
  549: def p_deploy(row, model, margin_model, singleton_null):
  550:     """Deployment-composed lookup: margin band -> band curve; singleton ->
  551:     decoy null; fallback pooled. MUST mirror mapv2_track1_run.PModel.p ג€”
  552:     including the LENGTH FEATURE: the runner buckets by the row's ALIGNED
  553:     length, so this lookup does too (Codex code-gate BLOCKER 2: bucketing
  554:     the holdout by crop len while deploying by alen would validate one bin
  555:     and deploy another)."""
  556:     alen = row.get('alen') or row['len']
  557:     band = margin_band_of(row)
  558:     if band == 'singleton' and singleton_null:
  559:         L = min(singleton_null, key=lambda x: abs(x - alen))
  560:         frac = 0.0
  561:         for d0, f in singleton_null[L]:
  562:             if row['dens'] <= d0:
  563:                 frac = f
  564:                 break
  565:         else:
  566:             frac = singleton_null[L][-1][1] if singleton_null[L] else 1.0
  567:         return max(0.0, 1.0 - frac)
  568:     bins = margin_model.get(band)
  569:     if bins:
  570:         L = min(bins, key=lambda x: abs(x - alen))
  571:         knots = bins[L]
  572:         for max_d, p, _n in knots:
  573:             if row['dens'] <= max_d:
  574:                 return p
  575:         return knots[-1][1] if knots else 0.0
  576:     return p_lookup(model, alen, row['dens'])
  577: 
  578: 
  579: def margin_reliability(hold, model, margin_model, singleton_null,
  580:                        by_alen=False):
  581:     """Holdout reliability of the DEPLOYMENT-composed lookup."""
  582:     hw = work_weights(hold, by_alen)
  583:     rel = defaultdict(lambda: [0.0, 0.0, 0])
  584:     for r in hold:
  585:         p = p_deploy(r, model, margin_model, singleton_null)
  586:         b = min(9, int(p * 10))
  587:         Lr = nearest_bin(r.get('alen') or r['len']) if by_alen else r['len']
  588:         w = hw[(Lr, r['true_work'])]
  589:         rel[b][0] += r['correct'] * w
  590:         rel[b][1] += w
  591:         rel[b][2] += 1
  592:     return {f"{b/10:.1f}-{(b+1)/10:.1f}":
  593:             {'n': n, 'pred_mid': (b + 0.5) / 10,
  594:              'empirical': round(kw / ww, 3)}
  595:             for b, (kw, ww, n) in sorted(rel.items()) if n > 0}
  596: 
  597: 
  598: # =====================================================================
  599: # final2 self-validation: (margin-band x alen-bin) reliability grid through
  600: # the DEPLOY path (p_deploy), with a comparison vs the crop-len-fit `final`
  601: # model. Reproduces the audit's ֲ§2 reliability grid so a re-fit can be judged
  602: # against the exact table the audit flagged.
  603: # =====================================================================
  604: 
  605: def load_deploy_model(path):
  606:     """Load a p_calibration_*.json into (model, margin_model, singleton_null)
  607:     typed exactly as PModel does (int length keys), so p_deploy can score
  608:     against it. Returns None if the file is absent/unreadable."""
  609:     try:
  610:         d = json.load(open(path, encoding='utf-8'))
  611:     except Exception as e:                                    # noqa: BLE001
  612:         log(f"comparison model {path} not loaded: {e!r}")
  613:         return None
  614:     model = {int(L): v for L, v in d.get('model', {}).items()}
  615:     margin_model = {b: {int(L): v for L, v in bins.items()}
  616:                     for b, bins in d.get('margin_model', {}).items()}
  617:     singleton_null = {int(L): v for L, v in d.get('singleton_null', {}).items()}
  618:     return model, margin_model, singleton_null
  619: 
  620: 
  621: def reliability_grid(hold, model, margin_model, singleton_null):
  622:     """Per (margin-band, alen-bin): raw n, work-weighted mean predicted P
  623:     (through p_deploy ג€” the deploy path), work-weighted empirical same-work
  624:     rate, and gap = pred - empirical. Work weight = 1 per (alen-bin, work)."""
  625:     hw = work_weights(hold, by_alen=True)
  626:     g = defaultdict(lambda: [0.0, 0.0, 0.0, 0])   # sum_w_pred, sum_w_corr, w, n
  627:     for r in hold:
  628:         band = margin_band_of(r)
  629:         L = nearest_bin(r.get('alen') or r['len'])
  630:         p = p_deploy(r, model, margin_model, singleton_null)
  631:         w = hw[(L, r['true_work'])]
  632:         cell = g[(band, L)]
  633:         cell[0] += p * w
  634:         cell[1] += r['correct'] * w
  635:         cell[2] += w
  636:         cell[3] += 1
  637:     out = {}
  638:     for (band, L), (sp, sc, sw, n) in g.items():
  639:         if sw > 0:
  640:             pred, emp = sp / sw, sc / sw
  641:             out[(band, L)] = {'n': n, 'pred': round(pred, 4),
  642:                               'emp': round(emp, 4), 'gap': round(pred - emp, 4)}
  643:     return out
  644: 
  645: 
  646: def grid_section(hold, new_deploy, final_path, worse_thresh=0.05):
  647:     """Build the (band x alen-bin) self-validation md section for final2,
  648:     comparing the new deploy composition against the crop-len-fit `final`
  649:     model at final_path (if present). Returns (md_lines, worsened, worst5)."""
  650:     new_grid = reliability_grid(hold, *new_deploy)
  651:     old = load_deploy_model(final_path)
  652:     old_grid = reliability_grid(hold, *old) if old else {}
  653: 
  654:     band_order = {b: i for i, b in enumerate(
  655:         ['singleton', 'm_ge_010', 'm_003_010', 'm_0_003', 'not_best'])}
  656:     keys = sorted(new_grid, key=lambda k: (band_order.get(k[0], 9), k[1]))
  657: 
  658:     lines = [
  659:         "### Self-validation ג€” holdout reliability grid (margin band ֳ— ALEN "
  660:         "bin) through the DEPLOY path",
  661:         "",
  662:         "Work-weighted (1 unit per (alen-bin, work)); `gap = pred גˆ’ empirical`. "
  663:         "`final gap` re-scores the SAME holdout rows through the crop-len-fit "
  664:         "`final` model for a like-for-like comparison. **`־”|gap|`** = "
  665:         "`|final2 gap| גˆ’ |final gap|` (negative = final2 improved); a bucket "
  666:         f"flagged **WORSE** regressed by > {worse_thresh}.",
  667:         "",
  668:         "| band | alen | n | final2 pred | empirical | final2 gap | final pred "
  669:         "| final gap | ־”\\|gap\\| | flag |",
  670:         "|---|---|---|---|---|---|---|---|---|---|",
  671:     ]
  672:     worsened, deltas = [], []
  673:     for k in keys:
  674:         band, L = k
  675:         v = new_grid[k]
  676:         ov = old_grid.get(k)
  677:         if ov:
  678:             dabs = round(abs(v['gap']) - abs(ov['gap']), 4)
  679:             deltas.append((k, dabs, v, ov))
  680:             worse = dabs > worse_thresh
  681:             if worse:
  682:                 worsened.append((k, dabs, v, ov))
  683:             lines.append(
  684:                 f"| {band} | {L} | {v['n']} | {v['pred']:.3f} | {v['emp']:.3f} "
  685:                 f"| {v['gap']:+.3f} | {ov['pred']:.3f} | {ov['gap']:+.3f} "
  686:                 f"| {dabs:+.3f} | {'**WORSE**' if worse else ''} |")
  687:         else:
  688:             lines.append(
  689:                 f"| {band} | {L} | {v['n']} | {v['pred']:.3f} | {v['emp']:.3f} "
  690:                 f"| {v['gap']:+.3f} | ג€” | ג€” | ג€” | |")
  691:     # summary
  692:     lines.append("")
  693:     if old_grid:
  694:         n_improved = sum(1 for _, d, _, _ in deltas if d < -1e-9)
  695:         n_regressed = len(worsened)
  696:         mean_abs_new = (sum(abs(new_grid[k]['gap']) for k in keys) / len(keys)
  697:                         if keys else 0.0)
  698:         common = [k for k in keys if k in old_grid]
  699:         mean_abs_new_c = (sum(abs(new_grid[k]['gap']) for k in common)
  700:                           / len(common) if common else 0.0)
  701:         mean_abs_old_c = (sum(abs(old_grid[k]['gap']) for k in common)
  702:                           / len(common) if common else 0.0)
  703:         lines.append(
  704:             f"**Mean |gap| over {len(common)} shared buckets: "
  705:             f"final2 {mean_abs_new_c:.3f} vs final {mean_abs_old_c:.3f}.** "
  706:             f"Improved: {n_improved}; regressed by >{worse_thresh}: "
  707:             f"{n_regressed}.")
  708:         if worsened:
  709:             lines.append("")
  710:             lines.append("**Buckets that regressed:**")
  711:             for (band, L), d, v, ov in sorted(worsened, key=lambda x: -x[1]):
  712:                 lines.append(
  713:                     f"- `{band}`/alen-{L}: |gap| {abs(ov['gap']):.3f} ג†’ "
  714:                     f"{abs(v['gap']):.3f} (־” {d:+.3f}); pred {ov['pred']:.3f}"
  715:                     f"ג†’{v['pred']:.3f}, empirical {v['emp']:.3f} (n={v['n']})")
  716:     else:
  717:         lines.append(f"(no `final` model at {final_path} ג€” no comparison)")
  718:     lines.append("")
  719:     return lines, worsened, new_grid, old_grid
  720: 
  721: 
  722: # =====================================================================
  723: # contamination / threshold sweep + decoys
  724: # =====================================================================
  725: 
  726: def sweep(rows, decoy_best, lwo_wrong, n_by_len, n_decoy_by_len):
  727:     """Per length, per density threshold: recall of the true work, wrong-work
  728:     share among accepted candidates, leave-work-out (absent-work) accept rate,
  729:     decoy chance-accept rate."""
  730:     TH = [0.20, 0.25, 0.30, 0.35, 0.40, 0.45, 0.50, 0.55, 0.60, 0.65, 0.70]
  731:     out = {}
  732:     by_len = defaultdict(list)
  733:     for r in rows:
  734:         by_len[r['len']].append(r)
  735:     for L in LENGTHS:
  736:         rs = by_len.get(L, [])
  737:         n_crops = n_by_len.get(L, 0)
  738:         # recall counted per CROP (true work accepted for that crop)
  739:         true_by_crop = defaultdict(list)
  740:         for r in rs:
  741:             if r['correct']:
  742:                 true_by_crop[r['crop_id']].append(r['dens'])
  743:         table = []
  744:         for t in TH:
  745:             acc = [r for r in rs if r['dens'] <= t]
  746:             n_true_crops = sum(1 for ds in true_by_crop.values()
  747:                                if min(ds) <= t)
  748:             n_true = sum(1 for r in acc if r['correct'])
  749:             n_wrong = len(acc) - n_true
  750:             lwo = lwo_wrong.get(L, [])
  751:             absent = (sum(1 for d in lwo if d <= t) / n_crops) \
  752:                 if n_crops else 0.0
  753:             dec = decoy_best.get(L, [])
  754:             chance = (sum(1 for d in dec if d <= t) / len(dec)) if dec else 0.0
  755:             table.append({'thresh': t,
  756:                           'recall': round(n_true_crops / max(1, n_crops), 3),
  757:                           'n_accepted': len(acc), 'n_wrong': n_wrong,
  758:                           'wrong_share': round(n_wrong / max(1, len(acc)), 3),
  759:                           'absent_work_accept': round(absent, 4),
  760:                           'decoy_accept': round(chance, 4)})
  761:         out[L] = table
  762:     return out
  763: 
  764: 
