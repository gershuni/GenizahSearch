  769: def load_graded_external(model):
  770:     """Best-effort: map graded cards to (length, density) -> predicted P vs
  771:     verdict. Defensive to schema drift; skips cards lacking density data."""
  772:     out = []
  773:     try:
  774:         cards = {c['id']: c for c in
  775:                  json.load(open(DISC_CARDS, encoding='utf-8'))}
  776:         for g in json.load(open(DISC_GRADES, encoding='utf-8')):
  777:             c = cards.get(g['id'])
  778:             if not c or c.get('type') != 'new_sample':
  779:                 continue
  780:             dens = c.get('best_density')

 succeeded in 856ms:
  781:             ml = c.get('matched_letters')
  782:             if dens is None or not ml:
  783:                 continue
  784:             correct = int(g['grade'] in
  785:                           ('confirmed-new-witness', 'correct-work-likely-known'))
  786:             out.append({'set': 'discovery_new', 'len': int(ml),
  787:                         'dens': float(dens),
  788:                         'pred': round(p_lookup(model, int(ml), float(dens)), 3),
  789:                         'human_correct': correct, 'grade': g['grade']})
  790:     except Exception as e:                                    # noqa: BLE001
  791:         log(f"external validation (discovery) skipped: {e!r}")
  792:     try:
  793:         cards = {c['id']: c for c in
  794:                  json.load(open(FRAG1_CARDS, encoding='utf-8'))}
  795:         for g in json.load(open(FRAG1_GRADES, encoding='utf-8')):
  796:             c = cards.get(g['id'])
  797:             if not c or g.get('type') not in ('density_fail', 'crop_recovered'):
  798:                 continue
  799:             # real schema (verified): density_fail carries cand_density +
  800:             # cand_aligned_len; crop_recovered carries density + crop_len.
  801:             if g['type'] == 'density_fail':
  802:                 dens, length = c.get('cand_density'), c.get('cand_aligned_len')
  803:             else:
  804:                 dens, length = c.get('density'), c.get('crop_len')
  805:             if dens is None or length is None:
  806:                 continue
  807:             correct = int(g['grade'] in ('candidate-correct', 'correct-id'))
  808:             out.append({'set': f"frag1_{g['type']}", 'len': int(length),
  809:                         'dens': float(dens),
  810:                         'pred': round(p_lookup(model, int(length), float(dens)), 3),
  811:                         'human_correct': correct, 'grade': g['grade']})
  812:     except Exception as e:                                    # noqa: BLE001
  813:         log(f"external validation (frag1) skipped: {e!r}")
  814:     return out
