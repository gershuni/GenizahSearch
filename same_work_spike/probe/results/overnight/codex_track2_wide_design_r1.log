  100:         g = _gram_codes(s)
  101:         if not len(g):
  102:             continue
  103:         max_len = max(max_len, len(g))   # position budget: ORIGINAL indices
  104:         pos = np.arange(len(g), dtype=np.uint64)
  105:         if masks:
  106:             iv = masks.get(pi)
  107:             if iv:
  108:                 keep = np.ones(len(g), dtype=bool)
