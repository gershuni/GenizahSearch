  134:     G = (keys >> np.uint64(_POS_BITS + _P_BITS)).astype(np.uint32)
  135:     P = ((keys >> np.uint64(_POS_BITS))
  136:          & np.uint64((1 << _P_BITS) - 1)).astype(np.uint32)
  137:     POS = (keys & np.uint64((1 << _POS_BITS) - 1)).astype(np.uint32)
  138:     del keys
