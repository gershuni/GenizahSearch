   71: 
   72: def build_candidates(streams, sys_codes, df_drop=100, band=20, min_anchors=2,
   73:                      chunk_pairs=80_000_000, log=print, masks=None,
   74:                      spill_dir=None, spill_min_hits=800_000_000,
   75:                      n_partitions=64):
   76:     # spill_min_hits history: 1.5B OOM'd the 63 GB box on the maskcanon FULL
   77:     # run (2026-07-08: canonical masking cut raw hits to ~1.48B ג€” just under
   78:     # the gate ג€” and the in-RAM final merge needs ~28 B/entry). 0.8B leaves
   79:     # the in-RAM path only for runs the box demonstrably handles (~650M).
   80:     """Returns (pa, pb, count, min_a, max_a, min_b, max_b) arrays + stats.
   81: 
   82:     masks: optional dict page_idx -> list of (start, end) stream intervals
   83:     (e.g. Track-1 canonical spans); grams whose k-window overlaps a masked
   84:     interval are not indexed ג€” 'Track 2 never sees canonical characters'.
   85: 
   86:     spill_dir: scratch directory for the two-pass disk-partitioned merge;
   87:     engaged only when raw pair-hits >= spill_min_hits (pass spill_min_hits=0
   88:     to force it, e.g. for parity testing). Spill files are deleted on return.
   89:     """
   90:     t0 = time.time()
   91:     n_pages = len(streams)
   92:     assert n_pages < (1 << _P_BITS)
   93:     sys_codes = np.asarray(sys_codes, dtype=np.int32)
