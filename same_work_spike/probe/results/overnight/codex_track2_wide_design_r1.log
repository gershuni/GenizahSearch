  111:                 n_masked_grams += int(len(g) - keep.sum())
  112:                 g, pos = g[keep], pos[keep]
  113:                 if not len(g):
  114:                     continue
  115:         key = ((g << np.uint64(_POS_BITS + _P_BITS))
  116:                | (np.uint64(pi) << np.uint64(_POS_BITS))
  117:                | pos)
  118:         parts.append(key)
  119:     assert max_len < (1 << _POS_BITS) and max_len < 655_360
  120:     keys = np.concatenate(parts)
  121:     del parts
  122:     n_positions = len(keys)
  123:     keys.sort()
  124:     t_index = time.time() - t0
  125:     log(f"[engine_np] positions={n_positions:,} sorted in {t_index:.0f}s")
  126: 
  127:     # ---- dedupe to first POS per (gram, page) ----
