  154:     stats['pair_hits_total'] = total_hits
  155:     log(f"[engine_np] grams kept={len(g_starts):,} "
  156:         f"(singleton={stats['grams_singleton']:,}, "
  157:         f"df-dropped={stats['grams_dropped_df']:,}); "
