  140:     # ---- gram groups + DF band ----
  141:     starts = np.flatnonzero(np.r_[True, G[1:] != G[:-1]])
  142:     sizes = np.diff(np.r_[starts, len(G)])
  143:     stats = {
  144:         'n_pages': n_pages, 'n_positions': n_positions,
  145:         'grams_masked': n_masked_grams,
  146:         'grams_total': len(starts),
  147:         'grams_singleton': int((sizes < 2).sum()),
