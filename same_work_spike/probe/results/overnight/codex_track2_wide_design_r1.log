  270: def _spill_path(_emit_chunk, n_chunks, band, min_anchors,
  271:                 spill_dir, n_partitions, stats, t0, log):
  272:     """Two-pass disk-partitioned merge (see module docstring)."""
  273:     os.makedirs(spill_dir, exist_ok=True)
  274:     paths = [os.path.join(spill_dir, f"part{p:03d}.bin")
  275:              for p in range(n_partitions)]
  276: 
  277:     # ---- pass 1: per-chunk (pair-key, count) reduce -> partitioned spill ----
  278:     t1 = time.time()
  279:     fhs = [open(p, 'wb') for p in paths]
  280:     spilled = 0
  281:     same_sys_dropped = 0
  282:     n_saturated = 0
  283:     try:
  284:         for ci in range(n_chunks):
  285:             pa, pb, posa, posb, nd = _emit_chunk(ci)
  286:             same_sys_dropped += nd
  287:             bucket = ((posa - posb) // band + _B_OFF).astype(np.uint64)
  288:             pkey = ((pa.astype(np.uint64) << np.uint64(_P_BITS + _B_BITS))
  289:                     | (pb.astype(np.uint64) << np.uint64(_B_BITS)) | bucket)
  290:             del pa, pb, posa, posb, bucket
  291:             pkey.sort()
  292:             s2 = np.flatnonzero(np.r_[True, pkey[1:] != pkey[:-1]])
  293:             cnt = np.diff(np.r_[s2, len(pkey)])
  294:             k2 = pkey[s2]
  295:             del pkey, s2
  296:             n_saturated += int((cnt > 65535).sum())
  297:             rec = np.empty(len(k2), dtype=_SPILL_DT)
  298:             rec['k'] = k2
  299:             rec['c'] = np.minimum(cnt, 65535).astype(np.uint16)
  300:             part = ((k2 >> np.uint64(_B_BITS))
  301:                     % np.uint64(n_partitions)).astype(np.uint16)
  302:             del k2, cnt
  303:             order = np.argsort(part, kind='stable')
  304:             rec, part = rec[order], part[order]
  305:             del order
  306:             bounds = np.r_[np.flatnonzero(np.r_[True, part[1:] != part[:-1]]),
  307:                            len(part)]
  308:             for bi in range(len(bounds) - 1):
