    1: # -*- coding: utf-8 -*-
    2: """Numpy sort-merge candidate generator ג€” the scale representation.
    3: 
    4: Semantics identical to engine.build_diag_pairs(per_gram_pair_cap=1):
    5: - char-k-gram inverted index over normalized letter streams
    6: - postings deduped to FIRST position per (gram, page)  == pair_cap=1
    7: - DF band: keep grams on 2 <= DF <= df_drop distinct pages
    8: - per shared gram, per page pair: one hit at diagonal bucket (pos_a-pos_b)//band
    9: - candidate = >= min_anchors hits within an adjacent-bucket chain
   10:   (chain-merge of buckets with gap <= 1; superset of the dict engine's
   11:   best-bucketֲ±1 cluster ג€” the verifier arbitrates)
   12: - same-sys_id pairs excluded at generation time
   13: 
   14: Representation: everything is packed uint64 keys + np.sort/reduceat.
   15: No Python dicts anywhere on the hot path.
   16: 
   17: Bit budgets (asserted): gram code < 27^5 < 2^24; page index < 2^20
   18: (repacked 18->20 for the 667K-page full corpus); position < 2^20
   19: (and < 655,360 for the 16-bit diagonal bucket). 24+20+20 = 64 exactly.
   20: 
   21: Two execution paths, same outputs:
   22: - in-RAM (default): per-chunk partial reduce with min/max positions,
   23:   one global final merge. Holds ~28 B/accumulator-entry ג€” fine to ~1B
   24:   entries on the 63 GB box.
   25: - two-pass disk spill (spill_dir= set AND raw hits >= spill_min_hits):
   26:   the full corpus emits ~4-5B raw hits; position records would need
   27:   ~126 GB, over the box's free disk. Pass 1 spills only (pair-key u8,
   28:   count u2) records (10 B/entry) hash-partitioned by page pair, then
   29:   reduces each partition independently -> candidate segments
   30:   (pair, bucket_lo, bucket_hi, count). Pass 2 re-emits the same hits
   31:   (deterministic: same gram tables, same chunk bounds) and recovers
   32:   min/max positions for candidate segments only via searchsorted.
   33: """
   34: import os
   35: import time
   36: 
   37: import numpy as np
   38: 
   39: K = 5
   40: BASE = np.uint64(27)
   41: HEB_MIN = 0x05D0
   42: 
   43: # packed (G,P,POS) sort key layout ג€” 24+20+20 = 64 bits exactly
   44: _POS_BITS = 20
   45: _P_BITS = 20
   46: # packed (pa,pb,bucket) pair key layout ג€” 20+20+16 = 56 bits
   47: _B_BITS = 16
   48: _B_OFF = 1 << (_B_BITS - 1)
   49: 
   50: # pass-1 spill record: packed pair key + saturating per-chunk hit count
   51: _SPILL_DT = np.dtype([('k', '<u8'), ('c', '<u2')])
   52: 
   53: 
   54: def _gram_codes(stream: str) -> np.ndarray:
   55:     """uint64 gram codes for all overlapping k-grams of a normalized stream."""
   56:     a = (np.frombuffer(stream.encode('utf-16-le'), dtype=np.uint16)
   57:          .astype(np.uint64) - np.uint64(HEB_MIN))
   58:     n = len(a) - K + 1
   59:     if n <= 0:
   60:         return np.empty(0, dtype=np.uint64)
   61:     c = np.zeros(n, dtype=np.uint64)
   62:     for j in range(K):
   63:         c = c * BASE + a[j:j + n]
   64:     return c
   65: 
   66: 
   67: def _reduceat_minmax(vals, starts):
   68:     return (np.minimum.reduceat(vals, starts),
   69:             np.maximum.reduceat(vals, starts))
