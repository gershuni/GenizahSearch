  100: def margin_band(m, n_competitors):
  101:     if n_competitors == 0:
  102:         return 'singleton'
  103:     if m <= 0:
  104:         return 'not_best'
  105:     if m >= 0.10:
  106:         return 'm_ge_010'
  107:     if m >= 0.03:
  108:         return 'm_003_010'
  109:     return 'm_0_003'
  110: 
  111: 
  112: class PModel:
  113:     """P(same-work | alen, density, margin-band) from p_calibration_final.
  114: 
  115:     - margin-band isotonic knots per (band, length-bin) where fitted;
  116:     - singleton band: decoy-anchored null P = 1 - DecoyBestCDF(len, dens)
  117:       (FRAG2-PLAN singleton finding: the band is unfittable from synthetic
  118:       crops; the chunk-shuffle decoys' best-candidate-density distribution IS
  119:       the chance-singleton null);
  120:     - fallback: pooled per-length isotonic.
  121:     Length feature: nearest calibrated length bin by the row's ALIGNED length
  122:     (calibration crops are fully covered, alen ~= crop len; documented
  123:     approximation for partially-covered pages).
  124:     """
  125: 
  126:     def __init__(self, path):
  127:         d = json.load(open(path, encoding='utf-8'))
  128:         self.meta = d.get('meta', {})
  129:         self.pooled = {int(L): v for L, v in d.get('model', {}).items()}
  130:         self.margin = {b: {int(L): v for L, v in bins.items()}
  131:                        for b, bins in d.get('margin_model', {}).items()}
  132:         self.singleton_null = {int(L): v for L, v in
  133:                                d.get('singleton_null', {}).items()}
  134:         if not self.pooled:
  135:             raise SystemExit(f"P model {path} has no pooled curves")
  136: 
  137:     @staticmethod
  138:     def _knot_lookup(knots, dens):
  139:         for max_d, p, _n in knots:
  140:             if dens <= max_d:
  141:                 return p
  142:         return knots[-1][1] if knots else 0.0
  143: 
  144:     def _nearest(self, bins, alen):
  145:         return min(bins, key=lambda L: abs(L - alen))
  146: 
  147:     def p(self, alen, dens, band):
  148:         if band == 'singleton' and self.singleton_null:
  149:             L = self._nearest(self.singleton_null, alen)
  150:             cdf = self.singleton_null[L]      # [[dens, cum_frac] ...] asc
  151:             frac = 0.0
  152:             for d0, f in cdf:
  153:                 if dens <= d0:
  154:                     frac = f
  155:                     break
  156:             else:
  157:                 frac = cdf[-1][1] if cdf else 1.0
  158:             return max(0.0, 1.0 - frac)
  159:         bins = self.margin.get(band)
  160:         if bins:
  161:             L = self._nearest(bins, alen)
  162:             return self._knot_lookup(bins[L], dens)
  163:         L = self._nearest(self.pooled, alen)
  164:         return self._knot_lookup(self.pooled[L], dens)
  165: 
  166: 
  167: # =====================================================================
  168: # per-page aggregation: hulls -> tier A / tier B rows
  169: # =====================================================================
  170: 
  171: def merge_spans(spans):
  172:     """[(p0,p1,dens)] -> merged [[p0,p1,dens]] (gap<=GAP_MERGE, min dens) ג€”
  173:     identical to track1_match.py's aggregation."""
  174:     spans = sorted(spans)
  175:     merged = []
  176:     for p0, p1, dens in spans:
  177:         if merged and p0 <= merged[-1][1] + GAP_MERGE:
  178:             merged[-1][1] = max(merged[-1][1], p1)
  179:             merged[-1][2] = min(merged[-1][2], dens)

