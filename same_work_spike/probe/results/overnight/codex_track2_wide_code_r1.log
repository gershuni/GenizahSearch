            ids_all.append(f'{c}_{ids[src_i]}')
            sys_all.append(real_sys[src_i])
            dec_is_decoy.append(True)
            dec_cohort.append(ci)
            dec_strat.append(len(ds))
    n_dec_total = len(dec_is_decoy)
