  630: # null model (shared by null + scored phases; reads persisted tables)
  631: # =====================================================================
  632: def compute_null_model(con):
  633:     n_real = int(meta_get(con, 'n_real_pages'))
  634:     n_dec = {ci: int(meta_get(con, f'n_decoy_{COHORT_TAGS[ci]}', '0'))
  635:              for ci in range(len(COHORT_TAGS))}
  636:     dc = np.zeros((len(COHORT_TAGS), N_ALEN_BINS, N_DENS_BINS, N_STRATA),
  637:                   dtype=np.float64)
  638:     for coh, ab, dbn, st, dn in con.execute(
  639:             "SELECT cohort,alen_bin,dens_bin,stratum,decoy_n FROM track2_decoy_counts"):
  640:         dc[COHORT_TAGS.index(coh), ab, dbn, st] = dn
  641: 
  642:     # observed real-real wide rows per bucket
  643:     obs = np.zeros((N_ALEN_BINS, N_DENS_BINS, N_STRATA), dtype=np.float64)
  644:     cur = con.execute("SELECT alen, dens, minlen FROM track2_wide")
  645:     while True:
  646:         chunk = cur.fetchmany(1_000_000)
  647:         if not chunk:
  648:             break
  649:         arr = np.array(chunk, dtype=np.float64)
  650:         ab = alen_bin_arr(arr[:, 0])
  651:         db = dens_bin_arr(arr[:, 1])
  652:         st = stratum_arr(arr[:, 2])
  653:         flat = (ab * N_DENS_BINS + db) * N_STRATA + st
  654:         binc = np.bincount(flat, minlength=obs.size)
  655:         obs += binc.reshape(obs.shape)
  656: 
  657:     # expected null per cohort + conservative envelope (max over cohorts)
  658:     exp = np.zeros_like(dc)
  659:     for ci in range(len(COHORT_TAGS)):
  660:         factor = n_real / (2.0 * max(1, n_dec[ci]))
  661:         exp[ci] = dc[ci] * factor
  662:     envelope = exp.max(axis=0)
  663:     with np.errstate(divide='ignore', invalid='ignore'):
  664:         raw = np.where(obs > 0, np.minimum(1.0, envelope / obs), 0.0)
  665:     smoothed = monotone_majorant(raw)
  666:     return dict(n_real=n_real, n_dec=n_dec, dc=dc, obs=obs, exp=exp,
  667:                 envelope=envelope, raw=raw, smoothed=smoothed)
  668: 
  669: 
  670: def monotone_majorant(raw):
  671:     """Conservative one-sided PAV (Codex smoothing requirement): the smallest
  672:     function >= raw that is non-decreasing in dens and non-increasing in alen,
  673:     per stratum. Implemented as cummax up the dens axis then cummax down the
  674:     alen axis -- a single pass suffices because the alen-cummax is a max over
  675:     dens-monotone slices, which stays dens-monotone."""
  676:     out = np.maximum.accumulate(raw, axis=1)               # dens non-decreasing
  677:     out = np.maximum.accumulate(out[::-1, :, :], axis=0)[::-1, :, :]  # alen non-incr
  678:     return np.minimum(out, 1.0)
  679: 
