def phase_engine_verify_spill(con, src, decoy_n, funnel):
    t0 = time.time()

    # ---- load real pages ----
    rows = src.execute(
        "SELECT page_id, sys_id, text FROM pages ORDER BY rowid").fetchall()
    ids = [r[0] for r in rows]
    real_sys = [r[1] for r in rows]
