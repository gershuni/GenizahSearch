 130:         self.margin = {b: {int(L): v for L, v in bins.items()}
 131:                        for b, bins in d.get('margin_model', {}).items()}
 132:         self.singleton_null = {int(L): v for L, v in
 133:                                d.get('singleton_null', {}).items()}
 134:         if not self.pooled:
