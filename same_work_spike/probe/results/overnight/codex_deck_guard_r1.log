  222: def snippet(text, spans, pad=80):
  223:     """(highlighted page-snippet html, matched stream slice) ג€” the slice is
  224:     used to locate the SAME passage in the reference edition."""
  225:     stream, offs = norm_stream(text)
  226:     p0, p1 = max(spans, key=lambda s: s[1] - s[0])[:2]
  227:     p0 = max(0, min(int(p0), len(offs) - 1))
  228:     p1 = min(int(p1), len(offs))
  229:     if not len(offs) or p1 <= 0:
  230:         return '', ''
  231:     a = offs[p0]
  232:     z = offs[p1 - 1] + 1
  233:     htm = (f"<span class='ctx'>{html.escape(text[max(0, a - pad):a])}</span>"
  234:            f"<mark>{html.escape(text[a:z][:600])}</mark>"
  235:            f"<span class='ctx'>{html.escape(text[z:z + pad])}</span>")
  236:     return htm, stream[p0:p1]
