   44:         # combining marks, punctuation, brackets, spaces, digits, Latin: dropped
   45:     return ''.join(out), offs
   46: 
   47: 
   48: def norm_words(text: str):
   49:     """Word-level normalization (letters-only words, finals folded).
   50: 
   51:     Words are defined by the ORIGINAL whitespace (unreliable under HTR,
   52:     use only where word units are required)."""
