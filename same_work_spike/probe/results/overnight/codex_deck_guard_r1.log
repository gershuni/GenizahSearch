  527: # =====================================================================
  528: # contamination / threshold sweep + decoys
  529: # =====================================================================
  530: 
  531: def sweep(rows, decoy_best, lwo_wrong, n_by_len, n_decoy_by_len):
  532:     """Per length, per density threshold: recall of the true work, wrong-work
  533:     share among accepted candidates, leave-work-out (absent-work) accept rate,
  534:     decoy chance-accept rate."""
  535:     TH = [0.20, 0.25, 0.30, 0.35, 0.40, 0.45, 0.50, 0.55, 0.60, 0.65, 0.70]
  536:     out = {}
  537:     by_len = defaultdict(list)
  538:     for r in rows:
  539:         by_len[r['len']].append(r)
  540:     for L in LENGTHS:
  541:         rs = by_len.get(L, [])
  542:         n_crops = n_by_len.get(L, 0)
  543:         # recall counted per CROP (true work accepted for that crop)
  544:         true_by_crop = defaultdict(list)
  545:         for r in rs:
  546:             if r['correct']:
  547:                 true_by_crop[r['crop_id']].append(r['dens'])
  548:         table = []
  549:         for t in TH:
  550:             acc = [r for r in rs if r['dens'] <= t]
  551:             n_true_crops = sum(1 for ds in true_by_crop.values()
  552:                                if min(ds) <= t)
  553:             n_true = sum(1 for r in acc if r['correct'])
  554:             n_wrong = len(acc) - n_true
  555:             lwo = lwo_wrong.get(L, [])
  556:             absent = (sum(1 for d in lwo if d <= t) / n_crops) \
  557:                 if n_crops else 0.0
  558:             dec = decoy_best.get(L, [])
  559:             chance = (sum(1 for d in dec if d <= t) / len(dec)) if dec else 0.0
  560:             table.append({'thresh': t,
  561:                           'recall': round(n_true_crops / max(1, n_crops), 3),
  562:                           'n_accepted': len(acc), 'n_wrong': n_wrong,
  563:                           'wrong_share': round(n_wrong / max(1, len(acc)), 3),
  564:                           'absent_work_accept': round(absent, 4),
  565:                           'decoy_accept': round(chance, 4)})
  566:         out[L] = table
  567:     return out
  568: 
