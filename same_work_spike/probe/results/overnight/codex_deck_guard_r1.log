  207: # =====================================================================
  208: # noise-injection arm (FRAG2-PLAN mitigation (b) -- TRIGGERED by the pilot
  209: # stress test: Hillel's real density_fail cards are 10/10 correct at density
  210: # 0.41-0.55 but clean-crop calibration predicts P 0.002-0.24 there. HTR noise
  211: # pushes CORRECT matches into densities where clean crops are mostly wrong,
  212: # so the clean model is PESSIMISTIC for the real orphan population. Injecting
  213: # the MEASURED HTR error profile (results/confusion_matrix.json, 209 FGP-
  214: # aligned pages) recalibrates for noisy-but-correct matches.)
  215: # =====================================================================
  216: 
  217: CONF_MATRIX = PROBE + r"\results\confusion_matrix.json"
  218: 
  219: 
  220: def load_noise_model():
  221:     """(sub_dist, ins_dist, op_weights) from the empirical profile.
  222:     sub_dist: ref_char -> ([hyp_chars], [cum_weights]); ins_dist likewise
  223:     global. Op mix approximated from available counts (full substitution
  224:     list; top-10 ins/del lists) -- a stress-arm approximation, documented."""
  225:     d = json.load(open(CONF_MATRIX, encoding='utf-8'))
  226:     subs = d['substitutions']                      # [ref, hyp, count]
  227:     by_ref = defaultdict(list)
  228:     for ref, hyp, cnt in subs:
  229:         by_ref[ref].append((hyp, cnt))
  230:     sub_dist = {ref: ([h for h, _ in lst], [c for _, c in lst])
  231:                 for ref, lst in by_ref.items()}
  232:     ins_top = d['report']['top_insertions']
  233:     ins_dist = ([e['hyp'] for e in ins_top], [e['count'] for e in ins_top])
  234:     n_sub = sum(c for _, _, c in subs)
  235:     n_del = sum(e['count'] for e in d['report']['top_deletions'])
  236:     n_ins = sum(e['count'] for e in ins_top)
  237:     return sub_dist, ins_dist, (n_sub, n_del, n_ins)
  238: 
  239: 
  240: def perturb(stream, rate, noise_model, rnd):
  241:     """Inject sub/del/ins errors at ~`rate` per letter, sampled from the
  242:     empirical HTR profile."""
  243:     sub_dist, ins_dist, (w_sub, w_del, w_ins) = noise_model
  244:     w_tot = w_sub + w_del + w_ins
  245:     out = []
  246:     for ch in stream:
  247:         r = rnd.random()
  248:         if r >= rate:
  249:             out.append(ch)
  250:             continue
  251:         op = rnd.random() * w_tot
  252:         if op < w_sub:
  253:             if ch in sub_dist:
  254:                 hyps, wts = sub_dist[ch]
  255:                 out.append(rnd.choices(hyps, weights=wts)[0])
  256:             else:
  257:                 out.append(rnd.choices(*ins_dist)[0])
  258:         elif op < w_sub + w_del:
  259:             pass                                   # deletion
  260:         else:
  261:             out.append(rnd.choices(*ins_dist)[0])  # insertion + keep char
  262:             out.append(ch)
  263:     return ''.join(out)
  264: 
  265: 
  266: # =====================================================================
  267: # candidate rows
  268: # =====================================================================
  269: 
  270: def best_per_work(cands):
  271:     """[(work_idx, alen, dens)] -> {work_idx: (dens, alen)} best per work."""
  272:     best = {}
  273:     for wi, alen, dens in cands:
  274:         if wi not in best or dens < best[wi][0]:
  275:             best[wi] = (dens, alen)
  276:     return best
  277: 
  278: 
  279: def collect_rows(crops, results, wid_to_wi, works=None, use_vgroups=False):
  280:     """One row per (crop, distinct candidate work) ג€” ALL works, no rank cap.
  281:     Also returns per-crop best WRONG-work density (the leave-work-out arm:
  282:     dropping the true work's candidates post-hoc is identical, on the accept
  283:     surface, to removing that work from the index ג€” measures how often a
  284:     wrong work would be accepted when the right one is ABSENT).
  285: 
  286:     use_vgroups (FINAL only): truth relation = version-group identity ג€” a
  287:     candidate in the SAME vgroup as the labeled work counts correct (multi-
  288:     rite liturgy twins etc. are the same-work answer, not contamination).
  289:     Adds per-row 'margin' (best-competing density minus this row's density,
  290:     None for singletons) + 'n_comp' for the margin-band model."""
  291:     def token_of(wi):
  292:         if use_vgroups and works is not None:
  293:             vg = works[wi].get('vgroup')
  294:             return ('vg', vg) if vg is not None else works[wi]['id']
  295:         return wi
  296: 
  297:     rows = []
  298:     recall_wide = Counter()
  299:     n_by_len = Counter()
  300:     lwo_wrong = defaultdict(list)          # length -> per-crop min wrong dens
  301:     for ci, (c, cands) in enumerate(zip(crops, results)):
  302:         n_by_len[c['length']] += 1
  303:         true_wi = wid_to_wi.get(c['work_id'])
  304:         true_tok = (token_of(true_wi) if true_wi is not None
  305:                     else c['work_id'])
  306:         bp = best_per_work(cands)
  307:         ranked = sorted(bp.items(), key=lambda kv: kv[1][0])
  308:         if any(token_of(wi) == true_tok for wi in bp):
  309:             recall_wide[c['length']] += 1
  310:         wrong_ds = [dens for wi, (dens, _a) in ranked
  311:                     if token_of(wi) != true_tok]
  312:         if wrong_ds:
  313:             lwo_wrong[c['length']].append(min(wrong_ds))
  314:         best_d = ranked[0][1][0] if ranked else None
  315:         second_d = ranked[1][1][0] if len(ranked) > 1 else None
  316:         for rank, (wi, (dens, alen)) in enumerate(ranked):
  317:             if len(ranked) == 1:
  318:                 m = None                        # singleton
  319:             elif rank == 0:
  320:                 m = second_d - dens
  321:             else:
  322:                 m = best_d - dens               # <= 0: not-best
  323:             rows.append({'crop_id': ci, 'len': c['length'], 'alen': alen,
  324:                          'dens': dens, 'rank': rank,
  325:                          'margin': (round(m, 4) if m is not None else None),
  326:                          'n_comp': len(ranked) - 1,
  327:                          'correct': int(token_of(wi) == true_tok),
  328:                          'true_work': c['work_id'], 'cat': c['cat'],
  329:                          'page_id': c['page_id']})
  330:     return rows, recall_wide, n_by_len, lwo_wrong
  331: 
  332: 
  333: # =====================================================================
  334: # PAVA isotonic fit (non-increasing P in density)
  335: # =====================================================================
  336: 
  337: def pava_decreasing(triples):
  338:     """triples = [(dens, y, w)] -> step function as [(max_dens, p, n)] blocks,
  339:     p non-increasing with density; weighted pool-adjacent-violators. `n` is
  340:     the RAW row count in the block (for the report); the fit uses weights."""
  341:     triples = sorted(triples)
  342:     blocks = []                       # each: [sum_wy, sum_w, n_rows, max_dens]
  343:     for dens, y, w in triples:
  344:         cur = [float(y) * w, w, 1, dens]
  345:         # non-increasing violated when previous block mean < current mean
  346:         while blocks and blocks[-1][0] / blocks[-1][1] < cur[0] / cur[1]:
  347:             prev = blocks.pop()
  348:             cur = [prev[0] + cur[0], prev[1] + cur[1],
  349:                    prev[2] + cur[2], cur[3]]
  350:         blocks.append(cur)
  351:     return [(b[3], b[0] / b[1], b[2]) for b in blocks]
  352: 
  353: 
  354: def work_weights(rows):
  355:     """Per-(length, true_work) equal-total-weight: each source work
  356:     contributes weight 1 per length bin regardless of how many candidate rows
  357:     its crops generated (Codex HIGH: raw rows overweight candidate-rich
  358:     works). Returns {id(row-key)->w} keyed by (len, true_work)."""
  359:     n_per = Counter((r['len'], r['true_work']) for r in rows)
  360:     return {k: 1.0 / n for k, n in n_per.items()}
  361: 
  362: 
  363: def p_lookup(model_bins, length, dens):
  364:     """Step-function lookup with clamping; nearest length bin."""
  365:     lb = min(model_bins, key=lambda L: abs(L - length))
  366:     knots = model_bins[lb]            # [(max_dens, p, n)] density-ascending
  367:     for max_d, p, _n in knots:
  368:         if dens <= max_d:
  369:             return p
  370:     return knots[-1][1] if knots else 0.0
  371: 
  372: 
  373: def fit_calibration(rows):
  374:     """Work-granular split -> per-length isotonic model + holdout reliability.
  375:     Returns the actual train/hold row lists so the margin-band model can be
  376:     fit on the SAME split."""
  377:     works = sorted({r['true_work'] for r in rows})
  378:     rnd = random.Random(RNG_SEED + 7)
  379:     rnd.shuffle(works)
  380:     n_hold = max(1, int(len(works) * HOLDOUT_FRAC))
  381:     hold_works = set(works[:n_hold])
  382:     train = [r for r in rows if r['true_work'] not in hold_works]
  383:     hold = [r for r in rows if r['true_work'] in hold_works]
  384: 
  385:     tw = work_weights(train)
  386:     model = {}
  387:     for L in LENGTHS:
  388:         pts = [(r['dens'], r['correct'], tw[(L, r['true_work'])])
  389:                for r in train if r['len'] == L]
  390:         if len(pts) >= 20:
  391:             model[L] = pava_decreasing(pts)
  392:     # reliability on holdout: bucket by predicted P, same per-work weighting
  393:     hw = work_weights(hold)
  394:     rel = defaultdict(lambda: [0.0, 0.0, 0])
  395:     for r in hold:
  396:         if r['len'] not in model:
  397:             continue
  398:         p = p_lookup(model, r['len'], r['dens'])
  399:         b = min(9, int(p * 10))
  400:         w = hw[(r['len'], r['true_work'])]
  401:         rel[b][0] += r['correct'] * w
  402:         rel[b][1] += w
  403:         rel[b][2] += 1
  404:     reliability = {f"{b/10:.1f}-{(b+1)/10:.1f}":
  405:                    {'n': n, 'pred_mid': (b + 0.5) / 10,
  406:                     'empirical': round(kw / ww, 3)}
  407:                    for b, (kw, ww, n) in sorted(rel.items()) if n > 0}
  408:     return model, reliability, train, hold, len(hold_works)
  409: 
  410: 
  411: # =====================================================================
  412: # margin-band model (FINAL; cal1_margin_refit.py finding folded in) +
  413: # decoy-anchored singleton null (FRAG2-PLAN singleton fix)
  414: # =====================================================================
  415: 
  416: MARGIN_BANDS = ['m_ge_010', 'm_003_010', 'm_0_003', 'not_best']
  417: MARGIN_FIT_FLOOR = 20
  418: 
  419: 
  420: def margin_band_of(row):
  421:     """Same band edges the Map-v2 runner deploys (mapv2_track1_run.py)."""
  422:     if row['n_comp'] == 0:
  423:         return 'singleton'
  424:     m = row['margin']
  425:     if m is None or m <= 0:
  426:         return 'not_best'
  427:     if m >= 0.10:
  428:         return 'm_ge_010'
  429:     if m >= 0.03:
  430:         return 'm_003_010'
  431:     return 'm_0_003'
  432: 
  433: 
  434: def fit_margin_model(train):
  435:     """{band: {L: knots}} isotonic per (margin-band, length) where >= floor
  436:     rows exist. The SINGLETON band is deliberately absent: only 12/921K pilot
  437:     rows were synthetic singletons (random crops of well-referenced works
  438:     always chance-match other works) ג€” it is scored by the decoy null."""
  439:     tw = work_weights(train)
  440:     out = {}
  441:     n_per = Counter()
  442:     for band in MARGIN_BANDS:
  443:         bins = {}
  444:         for L in LENGTHS:
  445:             pts = [(r['dens'], r['correct'], tw[(L, r['true_work'])])
  446:                    for r in train
  447:                    if r['len'] == L and margin_band_of(r) == band]
  448:             n_per[(band, L)] = len(pts)
  449:             if len(pts) >= MARGIN_FIT_FLOOR:
  450:                 bins[L] = pava_decreasing(pts)
  451:         if bins:
  452:             out[band] = bins
  453:     return out, {f"{b}/{L}": n for (b, L), n in sorted(n_per.items())}
  454: 
  455: 
  456: def build_singleton_null(decoy_best, n_decoy_by_len, max_knots=60):
  457:     """Chance null per length: CDF of the decoys' BEST-candidate density,
  458:     denominated over ALL decoy queries of that length (a decoy with no
  459:     candidate contributes only to the denominator). Deployment scores a
  460:     singleton at (L, d) as P ~= 1 - CDF_L(d): the probability that pure
  461:     chance would NOT produce a candidate this good. High-density singletons
  462:     (d > ~0.45) get low P automatically ג€” chance singletons are common
  463:     there (pilot n20 decoy_accept ~0.40 at len150/d0.50)."""
  464:     null = {}
  465:     for L, n_total in n_decoy_by_len.items():
  466:         ds = sorted(decoy_best.get(L, []))
  467:         if not n_total:
  468:             continue
  469:         knots = []
  470:         for i, d in enumerate(ds):
  471:             knots.append([round(d, 4), round((i + 1) / n_total, 5)])
  472:         if len(knots) > max_knots:
  473:             step = len(knots) / max_knots
  474:             knots = [knots[int(i * step)] for i in range(max_knots - 1)]
  475:             knots.append([round(ds[-1], 4), round(len(ds) / n_total, 5)])
  476:         null[L] = knots
  477:     return null
  478: 
  479: 
  480: def p_deploy(row, model, margin_model, singleton_null):
  481:     """Deployment-composed lookup: margin band -> band curve; singleton ->
  482:     decoy null; fallback pooled. MUST mirror mapv2_track1_run.PModel.p ג€”
  483:     including the LENGTH FEATURE: the runner buckets by the row's ALIGNED
  484:     length, so this lookup does too (Codex code-gate BLOCKER 2: bucketing
  485:     the holdout by crop len while deploying by alen would validate one bin
  486:     and deploy another)."""
  487:     alen = row.get('alen') or row['len']
  488:     band = margin_band_of(row)
  489:     if band == 'singleton' and singleton_null:
  490:         L = min(singleton_null, key=lambda x: abs(x - alen))
  491:         frac = 0.0
  492:         for d0, f in singleton_null[L]:
  493:             if row['dens'] <= d0:
  494:                 frac = f
  495:                 break
  496:         else:
  497:             frac = singleton_null[L][-1][1] if singleton_null[L] else 1.0
  498:         return max(0.0, 1.0 - frac)
  499:     bins = margin_model.get(band)
  500:     if bins:
  501:         L = min(bins, key=lambda x: abs(x - alen))
  502:         knots = bins[L]
  503:         for max_d, p, _n in knots:
  504:             if row['dens'] <= max_d:
  505:                 return p
  506:         return knots[-1][1] if knots else 0.0
  507:     return p_lookup(model, alen, row['dens'])
  508: 
  509: 
  510: def margin_reliability(hold, model, margin_model, singleton_null):
  511:     """Holdout reliability of the DEPLOYMENT-composed lookup."""
  512:     hw = work_weights(hold)
  513:     rel = defaultdict(lambda: [0.0, 0.0, 0])
  514:     for r in hold:
  515:         p = p_deploy(r, model, margin_model, singleton_null)
  516:         b = min(9, int(p * 10))
  517:         w = hw[(r['len'], r['true_work'])]
  518:         rel[b][0] += r['correct'] * w
  519:         rel[b][1] += w
  520:         rel[b][2] += 1
  521:     return {f"{b/10:.1f}-{(b+1)/10:.1f}":
  522:             {'n': n, 'pred_mid': (b + 0.5) / 10,
  523:              'empirical': round(kw / ww, 3)}
  524:             for b, (kw, ww, n) in sorted(rel.items()) if n > 0}
