    1: # -*- coding: utf-8 -*-
    2: """Full-corpus extraction: Transcriptions.txt -> fullcorpus.db.
    3: 
    4: Same streaming pass as extract_rehearsal.py, but keeps ALL pages passing
    5: stage-0 (short / target-sheet / FL-image dedup) ג€” no reservoir sampling.
    6: Tracer tags ('bh', 'tier1t') kept for recall instrumentation; everything
    7: else tagged 'all'.
    8: """
    9: import json
   10: import re
   11: import sqlite3
   12: import time
   13: from collections import Counter
   14: 
   15: from stage0 import fl_of, page_filter
   16: 
   17: ROOT = r"C:\Genizahsearch"
   18: SRC = ROOT + r"\Transcriptions.txt"
   19: BH = ROOT + r"\same_work_spike\probe\data\bh_witnesses.json"
   20: TIER1 = ROOT + r"\same_work_spike\probe\results\tier1.json"
   21: DB = ROOT + r"\same_work_spike\probe\data\fullcorpus.db"
   22: REPORT = ROOT + r"\same_work_spike\probe\data\fullcorpus_extract_report.txt"
   23: 
   24: HEADER_RE = re.compile(r'^==> (\S+) <==')
   25: BATCH = 5000
   26: 
   27: # ---- tracer targets ----
   28: bh = json.load(open(BH, encoding='utf-8'))
   29: bh_sys = set()
   30: for sig, w in bh['witnesses'].items():
   31:     for sm in w['shelfmarks']:
   32:         bh_sys.update(sm.get('sys_ids', []))
   33: 
   34: tier1 = json.load(open(TIER1, encoding='utf-8'))
   35: tier1_pages = set()
   36: for p in tier1['titles']:
   37:     tier1_pages.add(p['a'])
   38:     tier1_pages.add(p['b'])
   39: print(f"tracers: bh sys_ids={len(bh_sys)}, tier1-title pages={len(tier1_pages)}")
   40: 
   41: # ---- DB ----
   42: con = sqlite3.connect(DB)
   43: con.execute("DROP TABLE IF EXISTS pages")
   44: con.execute("""
   45:     CREATE TABLE pages (
   46:         page_id TEXT PRIMARY KEY,
   47:         sys_id TEXT NOT NULL,
   48:         buckets TEXT NOT NULL,
   49:         n_chars INTEGER,
   50:         text TEXT
   51:     )
   52: """)
   53: 
   54: # ---- stream ----
   55: drops = Counter()
   56: seen_fl = set()
   57: tag_counts = Counter()
   58: n_records = n_kept = 0
   59: pending = []
   60: t0 = time.time()
   61: cur_id = None
   62: buf = []
   63: 
   64: 
   65: def flush(cur_id, buf):
   66:     global n_records, n_kept
   67:     if cur_id is None:
   68:         return
   69:     n_records += 1
   70:     text = "\n".join(buf).strip()
   71:     reason = page_filter(text)
   72:     if reason:
   73:         drops[reason] += 1
   74:         return
   75:     fl = fl_of(cur_id)
   76:     if fl in seen_fl:
   77:         drops['dup_fl'] += 1
   78:         return
   79:     seen_fl.add(fl)
   80:     sys_id = cur_id.split('_')[0]
   81:     tags = []
   82:     if sys_id in bh_sys:
   83:         tags.append('bh')
   84:     if cur_id in tier1_pages:
   85:         tags.append('tier1t')
   86:     tag = ','.join(tags) if tags else 'all'
   87:     tag_counts[tag] += 1
   88:     n_kept += 1
   89:     pending.append((cur_id, sys_id, tag, len(text), text))
   90:     if len(pending) >= BATCH:
   91:         con.executemany("INSERT OR REPLACE INTO pages VALUES (?,?,?,?,?)",
   92:                         pending)
   93:         pending.clear()
   94: 
   95: 
   96: with open(SRC, encoding='utf-8', errors='replace') as f:
   97:     for line in f:
   98:         m = HEADER_RE.match(line)
   99:         if m:
  100:             flush(cur_id, buf)
  101:             cur_id = m.group(1)
  102:             buf = []
  103:         else:
  104:             buf.append(line.rstrip('\n'))
  105:     flush(cur_id, buf)
  106: 
  107: if pending:
  108:     con.executemany("INSERT OR REPLACE INTO pages VALUES (?,?,?,?,?)", pending)
  109: con.execute("CREATE INDEX idx_sys ON pages(sys_id)")
  110: con.commit()
  111: n_db = con.execute("SELECT COUNT(*) FROM pages").fetchone()[0]
  112: con.close()
  113: 
  114: elapsed = time.time() - t0
  115: lines = [
