  574: def load_graded_external(model):
  575:     """Best-effort: map graded cards to (length, density) -> predicted P vs
  576:     verdict. Defensive to schema drift; skips cards lacking density data."""
  577:     out = []
  578:     try:
  579:         cards = {c['id']: c for c in
  580:                  json.load(open(DISC_CARDS, encoding='utf-8'))}
  581:         for g in json.load(open(DISC_GRADES, encoding='utf-8')):
  582:             c = cards.get(g['id'])
  583:             if not c or c.get('type') != 'new_sample':
  584:                 continue
  585:             dens = c.get('best_density')
  586:             ml = c.get('matched_letters')
  587:             if dens is None or not ml:
  588:                 continue
  589:             correct = int(g['grade'] in
  590:                           ('confirmed-new-witness', 'correct-work-likely-known'))
  591:             out.append({'set': 'discovery_new', 'len': int(ml),
  592:                         'dens': float(dens),
  593:                         'pred': round(p_lookup(model, int(ml), float(dens)), 3),
  594:                         'human_correct': correct, 'grade': g['grade']})
  595:     except Exception as e:                                    # noqa: BLE001
  596:         log(f"external validation (discovery) skipped: {e!r}")
  597:     try:
  598:         cards = {c['id']: c for c in
  599:                  json.load(open(FRAG1_CARDS, encoding='utf-8'))}
  600:         for g in json.load(open(FRAG1_GRADES, encoding='utf-8')):
  601:             c = cards.get(g['id'])
  602:             if not c or g.get('type') not in ('density_fail', 'crop_recovered'):
  603:                 continue
  604:             # real schema (verified): density_fail carries cand_density +
  605:             # cand_aligned_len; crop_recovered carries density + crop_len.
  606:             if g['type'] == 'density_fail':
  607:                 dens, length = c.get('cand_density'), c.get('cand_aligned_len')
  608:             else:
  609:                 dens, length = c.get('density'), c.get('crop_len')
  610:             if dens is None or length is None:
  611:                 continue
  612:             correct = int(g['grade'] in ('candidate-correct', 'correct-id'))
  613:             out.append({'set': f"frag1_{g['type']}", 'len': int(length),
  614:                         'dens': float(dens),
  615:                         'pred': round(p_lookup(model, int(length), float(dens)), 3),
  616:                         'human_correct': correct, 'grade': g['grade']})
  617:     except Exception as e:                                    # noqa: BLE001
  618:         log(f"external validation (frag1) skipped: {e!r}")
  619:     return out
