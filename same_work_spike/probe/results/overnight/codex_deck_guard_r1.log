   90: # =====================================================================
   91: # sampling: single-work pages, crop inside the labeled span
   92: # =====================================================================
   93: 
   94: def sample_single_work_pages(con, text_con=None, require_htr=False):
   95:     """Pages with exactly ONE distinct live work label, confident + high
   96:     coverage; returns per page the largest labeled span's stream slice.
   97: 
   98:     FINAL mode: labels/spans from `con` (v1 fullcorpus.db ג€” the only labels
   99:     existing pre-rebuild); text from `text_con` (fullcorpus_v2.db) restricted
  100:     to provenance='htr' (identical text to v1, so v1 span offsets stay
  101:     valid; FGP-substituted pages are excluded and counted)."""
  102:     t0 = time.time()
  103:     tcon = text_con or con
  104:     n_fgp_skipped = 0
  105:     rows = con.execute("""
  106:         SELECT page_id, MIN(work_id), MIN(cat), MIN(spans_json),
  107:                MIN(best_density), COUNT(DISTINCT work_id)
  108:         FROM track1_matches
  109:         WHERE shadowed_by IS NULL
  110:         GROUP BY page_id
  111:         HAVING COUNT(DISTINCT work_id) = 1 AND MIN(best_density) <= ?
  112:     """, (DENSITY_MAX,)).fetchall()
  113:     pool = defaultdict(list)
  114:     for pid, wid, cat, spans_json, bd, _ in rows:
  115:         pool[cat].append((pid, wid, cat, spans_json))
  116:     log(f"single-work page pool: {sum(len(v) for v in pool.values()):,} pages, "
  117:         f"by cat: {dict((c, len(v)) for c, v in pool.items())} "
  118:         f"({time.time() - t0:.0f}s)")
  119: 
  120:     rnd = random.Random(RNG_SEED)
  121:     chosen, shortfall = [], {}
  122:     for cat, tgt in CAT_TARGETS.items():
  123:         cand = pool.get(cat, [])
  124:         # round-robin by work for diversity
  125:         by_work = defaultdict(list)
  126:         for it in cand:
  127:             by_work[it[1]].append(it)
  128:         for w in by_work:
  129:             rnd.shuffle(by_work[w])
  130:         wids = list(by_work)
  131:         rnd.shuffle(wids)
  132:         order, ptr, prog = [], {w: 0 for w in wids}, True
  133:         while prog:
  134:             prog = False
  135:             for w in wids:
  136:                 if ptr[w] < len(by_work[w]):
  137:                     order.append(by_work[w][ptr[w]])
  138:                     ptr[w] += 1
  139:                     prog = True
  140:         got = []
  141:         for pid, wid, _cat, spans_json in order:
  142:             if len(got) >= tgt:
  143:                 break
  144:             if require_htr:
  145:                 trow = tcon.execute(
  146:                     "SELECT text, provenance FROM pages WHERE page_id=?",
  147:                     (pid,)).fetchone()
  148:                 if trow and trow[1] != 'htr':
  149:                     n_fgp_skipped += 1
  150:                     continue
  151:             else:
  152:                 trow = tcon.execute(
  153:                     "SELECT text FROM pages WHERE page_id=?",
  154:                     (pid,)).fetchone()
  155:             if not trow or not trow[0]:
  156:                 continue
  157:             stream, _ = norm_stream(trow[0])
  158:             plen = len(stream)
  159:             if plen <= 0:
  160:                 continue
  161:             spans = json.loads(spans_json) if spans_json else []
  162:             if not spans:
  163:                 continue
  164:             s, e = max(spans, key=lambda sp: sp[1] - sp[0])[:2]
  165:             s, e = max(0, int(s)), min(plen, int(e))
  166:             if e - s < MIN_SPAN_LEN:
  167:                 continue
  168:             # coverage: labeled letters / page letters
  169:             cov = sum(min(plen, int(b)) - max(0, int(a))
  170:                       for a, b, *_ in spans) / plen
  171:             if cov < COVERAGE_MIN:
  172:                 continue
  173:             got.append({'page_id': pid, 'work_id': wid, 'cat': cat,
  174:                         'span_stream': stream[s:e]})
  175:         if len(got) < tgt:
  176:             shortfall[cat] = (len(got), tgt)
  177:         chosen.extend(got)
  178:     log(f"sampled {len(chosen):,} single-work pages "
  179:         f"({time.time() - t0:.0f}s); shortfalls: {shortfall or 'none'}"
  180:         + (f"; fgp-provenance pages skipped: {n_fgp_skipped}"
  181:            if require_htr else ""))
  182:     return chosen, shortfall
  183: 
  184: 
  185: def make_crops(pages, rnd):
  186:     crops = []
  187:     for pg in pages:
  188:         s = pg['span_stream']
  189:         for length in LENGTHS:
  190:             if len(s) < length:
  191:                 continue
  192:             for ci in range(CROPS_PER_LENGTH):
  193:                 off = rnd.randint(0, len(s) - length)
  194:                 crops.append({'page_id': pg['page_id'],
  195:                               'work_id': pg['work_id'], 'cat': pg['cat'],
  196:                               'length': length, 'crop_idx': ci,
  197:                               'stream': s[off:off + length]})
  198:     return crops
  199: 
  200: 
  201: def chunk_shuffle(stream, chunk, rnd):
  202:     parts = [stream[i:i + chunk] for i in range(0, len(stream), chunk)]
  203:     rnd.shuffle(parts)
  204:     return ''.join(parts)
  205: 
