  280:         self.cache[wid] = out
  281:         return out
  282: 
  283:     def passage(self, wid, page_slice, pad=40):
  284:         """Readable edition passage matching the page's stream slice."""
  285:         prep = self._prepped(wid)
  286:         if not prep or len(page_slice) < 20:
  287:             return ''
  288:         raw, stream, offs = prep
  289:         if len(stream) < len(page_slice):
  290:             return ''
  291:         res = partial_ratio_alignment(page_slice, stream, score_cutoff=30)
  292:         if res is None:
  293:             return ''
  294:         w0 = max(0, res.dest_start - pad)
  295:         w1 = min(len(stream), res.dest_end + pad)
  296:         if w1 <= w0:
  297:             return ''
  298:         return html.escape(raw[offs[w0]:offs[w1 - 1] + 1][:800])
  299: 
