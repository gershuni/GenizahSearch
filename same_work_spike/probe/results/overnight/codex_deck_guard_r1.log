   56: DB_V2 = PROBE + r"\data\fullcorpus_v2.db"
   57: REF_V2 = PROBE + r"\data\ref_corpus_v2.pkl"
   58: MASKS_V2 = PROBE + r"\data\ref_canon_masks_v2.json"
   59: # stage-tagged outputs: the PILOT (pre-REF-2) model must never be mistaken
   60: # for the FINAL (frozen Map-v2 state) model -- rerun with --tag final there.
   61: STAGE_DEFAULT = 'pilot'
   62: OUT_MODEL = PROBE + r"\data\p_calibration_{tag}.json"
   63: OUT_ROWS = PROBE + r"\data\cal1_rows_{tag}.json"
   64: OUT_MD = PROBE + r"\results\p_calibration_{tag}.md"
   65: FRAG1_CARDS = PROBE + r"\review\frag1_cards.json"
   66: FRAG1_GRADES = PROBE + r"\review\grades_frag1_2026-07-09.json"
   67: DISC_CARDS = PROBE + r"\review\discovery_cards.json"
   68: DISC_GRADES = PROBE + r"\review\grades_discovery_2026-07-09.json"
   69: 
   70: RNG_SEED = 20260710
   71: 
   72: # experiment parameters
   73: LENGTHS = [40, 60, 80, 100, 150, 200, 300]
   74: CROPS_PER_LENGTH = 2
   75: MIN_SPAN_LEN = 340                 # crop inside the labeled span only
   76: COVERAGE_MIN = 0.85
   77: DENSITY_MAX = 0.15
   78: CAT_TARGETS = {'Bible': 380, 'Maagarim': 300, 'JA': 160, 'Bavli': 80,
   79:                'Mishnah': 40, 'Yerushalmi': 16, 'Tosefta': 4}   # ~980 pages
   80: WIDE_CUTOFF = 0.75                 # record candidates out to here (A5 q=0.01
   81:                                    # envelope reached ~0.66 at short lengths)
   82: # NO top-K censoring: ALL distinct-work candidates are recorded (Codex HIGH ג€”
   83: # a rank cap hides lower-ranked false candidates and biases contamination
   84: # downward; any deployment rank policy is applied downstream, consistently).
   85: CHUNK_PRIMARY, CHUNK_OPT = 25, 10  # decoy shuffle protocols (A5)
   86: HOLDOUT_FRAC = 0.2                 # of true works, for reliability check
   87: P_TARGETS = [0.9, 0.7, 0.5, 0.3, 0.2]   # tier-B operating-point candidates
