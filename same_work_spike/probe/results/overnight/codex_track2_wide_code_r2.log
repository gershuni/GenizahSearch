def flank_dist(sa, sb, a0, a1, b0, b1):
    """Best (lowest) EQUAL-LENGTH flank normalized distance; None if none.
    Equal-length clipping is load-bearing (rehearsal_run / fix_flanks post-mortem)."""
    best = None
    L = min(FLANK, a0, b0)
